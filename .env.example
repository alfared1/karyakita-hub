# Tahap 1: Database & Autentikasi
DATABASE_URL="postgresql://karyakita_owner:password@ep-cool-cloud.us-east-2.aws.neon.tech/karyakita?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://karyakita_owner:password@ep-cool-cloud.us-east-2.aws.neon.tech/karyakita?sslmode=require"
AUTH_SECRET="karyakita-hub-super-secret-auth-key-32bytes-min"
AUTH_GOOGLE_ID="google-client-id-for-7-founders.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="google-client-secret"

# Tahap 1: Object Storage File Ringan (<= 5 MB)
STORAGE_BUCKET_URL="https://storage.karyakita.id/attachments"
STORAGE_ACCESS_KEY="r2-or-supabase-access-key"

# Tahap 2 & 3: Integrasi Bot WA / Telegram & Otomasi Cron
CRON_SECRET="karyakita-cron-secret-guard-token"
ENCRYPTION_KEY_32B="12345678901234567890123456789012"
WA_CLOUD_TOKEN="EAAG..."
WA_PHONE_NUMBER_ID="10987654321"
TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"

# Pengaturan Sistem Internal
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GRADUATION_THRESHOLD_IDR=3500000
